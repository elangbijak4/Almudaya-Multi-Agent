    },
    {
      "ux_intent": "Risk status",
      "component_choice": "status text plus icon and semantic color",
      "accessibility_behavior": "status is not conveyed by color alone"
    }
  ],
  "semantic_tokens": {
    "source": "AVDS semantic token contract",
    "scaling": "platform typography scaling supported"
  },
  "verification_plan": {
    "tests": [
      "unit",
      "integration",
      "accessibility semantics"
    ],
    "known_unverified_areas": [
      "physical outdoor sunlight test",
      "device-specific location permission flow"
    ]
  }
}