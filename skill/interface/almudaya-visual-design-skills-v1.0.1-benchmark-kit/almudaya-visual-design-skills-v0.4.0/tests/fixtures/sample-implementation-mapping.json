{
  "product": {
    "name": "Almudaya Research Field App",
    "purpose": "Capture field observations and synchronize research data"
  },
  "target_environment": {
    "platform": "android",
    "minimum_version": "project-defined",
    "framework": "Flutter",
    "form_factors": [
      "phone",
      "tablet"
    ],
    "input_modalities": [
      "touch",
      "keyboard",
      "screen-reader"
    ],
    "output_modalities": [
      "visual",
      "haptic"
    ],
    "device_capabilities": [
      "camera",
      "location",
      "offline-storage"
    ]
  },
  "design_decision": {
    "primary_visual_style": "organic-nature",
    "platform_profile": "android",
    "interaction_profiles": [
      "touch",
      "keyboard"
    ],
    "rationale": "Field use requires clear touch controls, readable status, and resilient offline workflows"
  },
  "component_mapping": [
    {
      "ux_intent": "Primary navigation",
      "component_choice": "adaptive platform navigation",
