{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emergent Bug Hunt Input",
  "type": "object",
  "required": [
    "bug_report",
    "workspace_ref"
  ],
  "properties": {
    "bug_report": {
      "type": "string",
      "minLength": 15
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "reproduction_hint": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
