{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AVDS Platform Target",
  "type": "object",
  "required": [
    "platform",
    "primary_tasks",
    "modalities",
    "constraints"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "windows-desktop",
        "macos-desktop",
        "linux-desktop",
        "android",
        "ios",
        "tablet",
        "tv",
        "wearable",
        "automotive",
        "industrial-hmi",
        "spatial-xr",
        "voice-conversational"
      ]
    },
    "primary_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mouse-pointer",
          "keyboard",
          "touch",
          "stylus",
          "voice",
          "gesture",
          "gaze-spatial",
          "remote-dpad",
          "haptic",
          "multimodal"
        ]
      }
    },
    "constraints": {
      "type": "object"
    },
    "native_conventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
