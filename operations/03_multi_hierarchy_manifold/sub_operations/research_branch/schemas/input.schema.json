{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Branch Input",
  "type": "object",
  "required": [
    "project_brief",
    "evidence_requirements"
  ],
  "properties": {
    "project_brief": {
      "type": "string",
      "minLength": 20
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "domain": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
