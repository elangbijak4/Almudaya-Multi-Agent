{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AVDS Cross-Platform Design Brief",
  "type": "object",
  "required": [
    "product",
    "primary_style",
    "targets",
    "shared_semantics"
  ],
  "properties": {
    "product": {
      "type": "string"
    },
    "primary_style": {
      "type": "string"
    },
    "secondary_styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_semantics": {
      "type": "object"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "platform-target.schema.json"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
