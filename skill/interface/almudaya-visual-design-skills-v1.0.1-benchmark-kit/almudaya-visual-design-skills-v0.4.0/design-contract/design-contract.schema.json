{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almudaya.org/avds/schemas/design-contract.schema.json",
  "title": "AVDS Design-to-Code Contract",
  "type": "object",
  "required": [
    "contract_id",
    "version",
    "status",
    "project_id",
    "artifacts",
    "constraints",
    "handoff"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "implemented",
        "verified",
        "superseded",
        "blocked"
      ]
    },
    "project_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "type",
          "version",
          "status",
          "path"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "design_brief",
              "style_resolution",
              "platform_resolution",
              "composition_plan",
              "component_tree",
              "token_contract",
              "implementation_manifest",
              "qa_report",
              "other"
            ]
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could",
              "wont"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "current_phase",
        "requested_output",
        "acceptance_criteria"
      ],
      "properties": {
        "current_phase": {
          "type": "string"
        },
        "requested_output": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assigned_agent_role": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
