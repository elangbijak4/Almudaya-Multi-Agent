{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iterative Quality Loop Input",
  "type": "object",
  "required": [
    "requirement",
    "workspace_ref",
    "acceptance_criteria"
  ],
  "properties": {
    "requirement": {
      "type": "string",
      "minLength": 10
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "test_commands_profile": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
